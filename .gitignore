# Derived state. All of it is rebuildable from git + sources.manifest, and none
# of it should ever be committed: the clones are copies of other repositories,
# the database is a cache, and the config directory holds the DB password.
sources/
db/
backups/
.gbrain/
models/

# API keys for a LOCAL install. brain.conf is committed and holds only the
# NAME of each key variable; the values live here and never leave the machine.
/.env

*.log
.DS_Store
