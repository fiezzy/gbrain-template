# Copy to .env and fill in. .env is gitignored — it holds secrets.
#
#   cp .env.example .env && $EDITOR .env

# Identity. BRAIN_ID names the compose project, so two brains on one host do
# not collide.
BRAIN_ID=acme
DOMAIN=brain.acme.example

# Database. The password is used by both the db container and the gbrain
# container; generate one and never reuse it.
#   openssl rand -hex 24
PG_USER=brain
PG_DB=acme_brain
PG_PASSWORD=

# File ownership inside the container. Set these to the user that owns the
# checkout, so index clones and inbox notes stay editable from the host:
#   echo "HOST_UID=$(id -u)"; echo "HOST_GID=$(id -g)"
HOST_UID=1000
HOST_GID=1000

# Embedding provider. Server mode wants a hosted one: the local Ollama profile
# needs ~8GB of RAM and, without a GPU, turns a first index into an overnight
# job. Set exactly the key your brain.conf selects.
VOYAGE_API_KEY=
ZEROENTROPY_API_KEY=
OPENAI_API_KEY=

# Reranker key. Which one depends on RERANK_HOSTED_MODEL in brain.conf.
# NOTE: Voyage has no reranker at all, so an embedding key never covers this.
#   openrouter      cohere/rerank-v3.5 — open signup, one key, many models
#   dashscope       qwen3-rerank (Alibaba) — needs a region-aware key
#   zeroentropyai   zerank-2 — signups were closed as of 2026-08
OPENROUTER_API_KEY=
DASHSCOPE_API_KEY=

# Optional: chat model for the background enrichment cycle.
ANTHROPIC_API_KEY=

# PRIVATE REPOSITORIES over HTTPS. A container has no credential helper, so
# without this a private clone fails on an auth prompt it cannot answer.
# A PAT with read access to the repos, or simply: gh auth token
GITHUB_TOKEN=

# Read-only deploy key for private repositories cloned over SSH (git@github...). Put an SSH private key named
# `id_deploy` in this directory and register its public half as a deploy key on
# each repo.
DEPLOY_KEY_DIR=./keys

# Pin. Keep it identical to brain.conf so local and server behave the same.
GBRAIN_PIN=v0.42.73.2

# Optional: pre-set the /admin bootstrap token instead of reading it off the
# first-boot logs. Generate with `openssl rand -hex 32`.
ADMIN_BOOTSTRAP_TOKEN=
